# =============================================================================
# GENERATED FROM scripts/lib/env-manifest.ts — DO NOT EDIT BY HAND.
# Add or change a variable in that manifest, then run `pnpm env:sync`.
#
# This is the single canonical .env location — loaded by every package.
# Copy to .env and fill in real values: cp .env.example .env
# Do NOT create per-app .env files (e.g. apps/server/.env).
#
# For a PRODUCTION environment, don't fill this in by hand — run
# `pnpm generate:secrets`. It generates the random values, prompts only for
# what it can't know, skips whatever your deploy platform injects, and
# validates the result before printing it.
#
# Server vs worker: the env package is split. The BullMQ worker validates
# only the worker-safe (shared) surface — DATABASE_URL, REDIS_URL,
# NODE_ENV, KB_ASSET_* location/cache settings, SMTP, and the translation
# keys. The server-only vars (BETTER_AUTH_*, CORS_ORIGIN, SSO_*,
# SIGNUP_ENABLED, VAPID_*, ADMIN_EMAIL, RATE_LIMIT_*, IMAGE_*,
# ASSET_UPLOAD_MAX_BYTES, SSR_CACHE_TTL_SECONDS) are NOT required by a
# worker-only deployment. For local dev you set everything in one file
# regardless; the split only matters when server and worker run on
# separate hosts. Sections are tagged [shared] or [server-only].
#
# Structure: core/required vars first, then optional feature blocks
# (shipped commented out — uncommenting a block is what turns the feature
# on), then one clearly-marked Advanced tuning section of one-off knobs,
# each commented with its working default. The FULL variable catalog —
# including one-shot restore/runtime knobs that must stay unset on
# normal services — lives in scripts/lib/env-manifest.ts.
#
# NOTE: There is no auth-bypass mode. To exercise the real signup →
# email-verification → 2FA flow locally, use `pnpm dev:docker` — it ships
# an in-stack mailpit SMTP sink that captures verification email offline
# with zero credentials.
# =============================================================================

# --- Datastores — [shared] (server + worker) -------------------------------

# e.g. postgresql://user:password@host:5432/dbname — or leave blank to omit and set it on the platform
DATABASE_URL=postgresql://postgres:password@localhost:5432/knowledge_base

# Valkey (Redis-compatible; Redis also works), used by BullMQ and rate limiting.
REDIS_URL=redis://localhost:6379

# --- Runtime + migrations — [shared] ---------------------------------------
# Server startup applies committed migrations by default; workers wait and register.
# Use MIGRATE_ON_START=false with a one-shot migrate job before rollout.
# See docs/schema-migrations.md for backup requirements and deletion holds.

# Server default true; worker default false. Wait mode registers an instance and waits up to 300 seconds.
# Use the migrate image command for a one-shot before rollout.
# Allowed: true | false
# MIGRATE_ON_START=true

# Set to `production` on every deployed environment. Several env guards
# escalate from a warning to a hard boot failure when this is `production`
# — that is intentional, do not weaken it to silence a startup error.
# Allowed: production | development | test
# NODE_ENV=production

# [shared] One local data volume: repos/ (bare Git repos), assets/ (content-addressed
# blobs), models/ (optional local embedding weights) and index/. Server and worker
# both mount it read-write. Must be a local filesystem on the same host.
# Local raw dev should override to a writable directory.
# KB_DATA_ROOT=/var/lib/knowledge-base

# [shared] Fixed nonroot UID that owns the volume directories (node:26-trixie-slim `node` user).
# KB_RUNTIME_UID=1000

# [shared] Fixed nonroot GID that owns the volume directories.
# KB_RUNTIME_GID=1000

# [shared] REQUIRED on server and worker for at-rest encryption and cursor signing.
# Canonical base64 of exactly 32 bytes. Server and worker both receive it;
# it is never a VITE_* client variable and is not inlined into the SPA.
KB_MASTER_KEY=

# --- Optional S3 asset authority and bounded local cache -------------------
# Default OFF: assets remain authoritative on disk. See docs/assets.md before enabling.
# Provision offline with the migration command before starting S3 runtimes.
#
# Disabled by default — uncomment to enable.

# Required S3 cache payload limit in bytes (at least 26214400).
# KB_ASSET_CACHE_MAX_BYTES=
# Default false: authoritative disk CAS. Enable only after offline initialization/migration; see docs/assets.md.
# KB_ASSET_S3_ENABLED=false
# Dedicated private asset namespace, separate from backup dumps. Must match the recorded locator.
# KB_ASSET_S3_BUCKET=
# Optional HTTP(S) origin for S3-compatible storage, without credentials, path, query or fragment.
# KB_ASSET_S3_ENDPOINT=
# Required when enabled. Use a real AWS region without a custom endpoint; auto requires an endpoint.
# KB_ASSET_S3_REGION=
# Optional dedicated key prefix; outer slashes are normalized and traversal is refused.
# KB_ASSET_S3_PREFIX=
# Strict true/false, default false. Include this in every role locator.
# KB_ASSET_S3_FORCE_PATH_STYLE=false
# Actual runtime writer ID. Forward this same ID unchanged to offline dump consumers for comparison only.
# KB_ASSET_S3_ACCESS_KEY_ID=
# Server only. Never forward to workers, backup, restore or migration roles.
# KB_ASSET_S3_SECRET_ACCESS_KEY=
# Separate offline asset identity. Every enabled dump consumer compares its dump key against both asset IDs.
# KB_ASSET_S3_OPERATOR_ACCESS_KEY_ID=
# Offline only. Use read-only asset grants for backup/restore and List/Get/Put for migration; never give this secret to server/worker.
# KB_ASSET_S3_OPERATOR_SECRET_ACCESS_KEY=

# --- Encrypted full-bundle backups — [shared] ------------------------------
# Encrypted Postgres + Git + file-store bundles; BACKUP_AGE_RECIPIENT is required.
# Local completed bundles are valid; configured S3 uploads must succeed before migrations.
# Dedicated backup writer and ListBucket-only monitor credentials stay separate.
# The server image provides backup, backup-schedule and offline restore commands.
# See docs/backup-restore.md. Daily scheduling is off until explicitly enabled.
#
# Disabled by default — uncomment to enable.

# Opt in to one verified encrypted full bundle per UTC day in the backup service.
# Allowed: off | daily
# BACKUP_SCHEDULE=off

# Master switch for full-bundle backups and freshness monitoring. When false, manual and
# scheduled runs are disabled; initialized-database migration/drop hooks refuse mutation.
# Allowed: true | false
# BACKUP_ENABLED=true
# Use pinned age v1.3.2. Recommend age-keygen -pq (age1pq1 recipient); classic age1 accepted. Keep the private identity and master/auth secrets separately; mount the KB_DATA_ROOT data volume read-only on the offline backup role.
# BACKUP_AGE_RECIPIENT=
# Private bucket for pg_dump custom-format dumps. Prefer a dedicated bucket, not the app-assets bucket.
# BACKUP_S3_BUCKET=
# Required for dump writers. Must be a distinct GetObject/PutObject/AbortMultipartUpload key.
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# ListBucket-only key for the worker freshness check; never reuse the dump read/write key.
# BACKUP_MONITOR_S3_ACCESS_KEY_ID=
# BACKUP_MONITOR_S3_SECRET_ACCESS_KEY=
# "auto" for Cloudflare R2; a real region for AWS S3
# BACKUP_S3_REGION=auto
# BACKUP_S3_ENDPOINT=

# --- Auth — [server-only] --------------------------------------------------

# REQUIRED, minimum 32 characters. The env validator rejects weak and
# placeholder values in production. Rotating this invalidates every
# existing session — generate once per environment and keep it stable.
#
# For LOCAL dev this is filled in for you by `pnpm run setup`; to mint one
# by hand use `pnpm generate:secret` and paste it below. For a PRODUCTION
# environment prefer `pnpm generate:secrets`, which generates this along
# with the rest of the block and validates the result.
BETTER_AUTH_SECRET=
# Origin only — no path, query, hash, or credentials. e.g. https://app.example.com
BETTER_AUTH_URL=https://knowledge-base.localhost

# Optional. Set ONLY when the browser app runs on a different origin than
# the API (raw web dev, split-origin deploys). Leave unset for
# the default same-origin flow. No path, query, or hash.
# CORS_ORIGIN=https://app.example.com

# --- Admin + signup — [server-only] ----------------------------------------

# Canonical owner email for the first production admin. Matching is
# case-insensitive and surrounding whitespace is ignored; one address only.
# Required before a fresh production database can bootstrap, including when
# SIGNUP_ENABLED=true. After bootstrap, admins persist in the database.
# ADMIN_EMAIL=admin@example.com

# DISABLED by default: account creation is rejected and the signup form is
# hidden — the safe default for internal tools. Set `true` for a
# customer-facing app, which also REQUIRES SMTP below (email verification
# is enforced on signup and the server refuses to boot without it).
# SIGNUP_ENABLED=false

# --- Email (SMTP) — [shared] -----------------------------------------------
# REQUIRED if SIGNUP_ENABLED=true — Better-Auth enforces email verification
# on signup, and the server refuses to boot in production without it.
# Local dev: `pnpm dev:services` starts a mailpit sink and `pnpm run setup`
#   fills these three lines automatically; read captured mail at
#   http://localhost:8025
#
# Disabled by default — uncomment to enable.

# e.g. smtp.resend.com, smtp.postmarkapp.com, email-smtp.us-east-1.amazonaws.com
# SMTP_HOST=localhost
# 587 for STARTTLS (most providers), 465 for implicit TLS, 1025 for a local mailpit sink
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# One mailbox, e.g. "App Name <no-reply@yourdomain.com>". Required whenever SMTP_HOST is set.
# SMTP_FROM=noreply@example.com

# --- SSO / enterprise login — [server-only] --------------------------------
# Optional. FORCE_SSO=true in production requires SSO_ENABLED plus all
# three SSO_CLIENT_ID / SSO_CLIENT_SECRET / SSO_ISSUER values, or the
# server throws at boot.
#
# Disabled by default — uncomment to enable.

# SSO_ENABLED=true
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# e.g. https://your-org.okta.com
# SSO_ISSUER=https://your-org.okta.com
# e.g. "Okta", "Entra ID", "Google Workspace"
# SSO_PROVIDER_NAME=Okta

# --- Web Push (VAPID) — [server-only] --------------------------------------
# Optional — the app runs fine without these. Set ALL THREE or none.
# The keypair is generated for you by `pnpm generate:secrets`; you supply
# VAPID_SUBJECT, a real mailto: or https: URL push services use to reach
# YOU about delivery problems.
#
# Disabled by default — uncomment to enable.

# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# A mailto: or https: URL push services use to contact YOU about delivery problems. Use a real, monitored address.
# VAPID_SUBJECT=mailto:you@yourdomain.com

# --- Translation provider — [shared] ---------------------------------------
# Used by `pnpm i18n:translate`.
# The app boots without these; the worker throws on the first job if the
# chosen provider's key is missing. Default provider is `openrouter` with
# `anthropic/claude-haiku-4-5` (~$0.05 for a full UI bundle).
#
# Disabled by default — uncomment to enable.

# Allowed: openrouter | anthropic
# TRANSLATION_PROVIDER=openrouter
# Required when TRANSLATION_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# Required when TRANSLATION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- Advanced tuning -------------------------------------------------------
# One-off tuning knobs, grouped by feature. Every value has a working
# default shown on its line — uncomment and change ONLY the one you need.
# Rate-limit budgets rescale their whole limiter family coherently
# (multiplier = provided / reference); tighter is not safer — see
# AGENTS.md § Rate limiting — one bucket per surface.
# Deeper one-shot knobs (restore confirmations, runtime identities) are
# deliberately absent from this file;
# the full catalog lives in scripts/lib/env-manifest.ts.

# === Datastores — [shared] (server + worker) ===

# Max connections in this process's Postgres pool (node-postgres `max`).
# Default 10 matches the driver default — raise it only against the
# database's connection budget, since every server/worker replica holds its own pool.
# DATABASE_POOL_MAX=10

# === Auth — [server-only] ===

# Exact number of trusted reverse proxies in front of the app, for
# deriving the client IP used as the anonymous rate-limit key. 0 (default)
# keys on the socket peer and ignores X-Forwarded-For; behind a proxy that
# puts every client in one shared bucket. 1 behind a single proxy (the
# generated Dokploy Compose sets 1); 2 for Cloudflare -> Traefik only when
# Traefik trusts Cloudflare's ranges (docs/deploy.md). With N > 0 the app
# must be reachable only through those proxies.
# TRUST_PROXY_HOPS=0

# === SSO / enterprise login — [server-only] ===

# true disables password login entirely. In production this requires
# SSO_ENABLED plus all three SSO credentials or the server throws at boot.
# FORCE_SSO=false

# === Rate limiting — [server-only] ===
# Three named budgets (AUTH, RPC, EMAIL), two knobs
# each. Each budget describes its family's reference member; every other
# limiter in the family scales with it at its designed ratio, so setting
# a budget re-tunes the whole family coherently. Defaults are sensible;
# tighter is not safer — if a surface 429s legitimate users, split the
# surface instead of shrinking a budget. See AGENTS.md § Rate limiting — one bucket per surface.

# Auth family reference: requests per IP per window on the general /api/auth/* surface (password reset, verification, session ops). Setting it rescales the whole fail-closed auth family at each member's designed ratio: credential 10, credential-burst 3/10s, signup 10/h, 2FA-OTP 3/15min.
# RATE_LIMIT_AUTH_POINTS=30
# Window (seconds) for the auth family reference. Scales every auth-family window AND block duration by the same factor.
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# RPC family reference: requests per user (per IP signed out) per window on /rpc/*. /ready (60) and the SSR catch-all (300) scale with it. One batched request can carry up to ORPC_BATCH_MAX_SIZE procedures.
# RATE_LIMIT_RPC_POINTS=100
# Window (seconds) for the RPC family reference; scales /ready and SSR with it.
# RATE_LIMIT_RPC_WINDOW_SECONDS=60
# Email family reference: mails per RECIPIENT per window on the anonymous send-mail endpoints (verification resend, password reset). Signup (6) and sign-in-triggered mails (10) scale with it. Keyed on the mailbox, so rotating IPs cannot flood one inbox. 0 disables the whole recipient family.
# RATE_LIMIT_EMAIL_POINTS=3
# Window (seconds) for the email family reference; scales all three recipient buckets with it.
# RATE_LIMIT_EMAIL_WINDOW_SECONDS=3600

# === Cache limits — [server-only] ===
# Optional tuning. Sensible defaults are built in.

# In-memory SSR HTML cache for anonymous GETs of public routes. 0 disables
# it. Public content edits can take up to this long to appear live.
# SSR_CACHE_TTL_SECONDS=60
