{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["BUILD_VERSION", "VITE_*"],
      // `.env*` is package-relative (apps/web/.env…). `$TURBO_ROOT$/.env` is the
      // repo-root file, which apps/web/vite.config.ts hydrates into the Vite
      // process — and Vite's loadEnv merges prefix-matching process.env keys, so a
      // VITE_* key there changes the emitted client bundle. Without it Turbo would
      // replay a stale dist.
      //
      // Scoped to `build` rather than declared in `globalDependencies`: a global
      // entry puts the file's content hash in the cache key of EVERY task, so
      // rotating a local SMTP password would invalidate lint, test, and
      // check-types too. Only the build output can depend on this file.
      // `BUILD_VERSION` is the build identifier apps/web/vite.config.ts reads
      // (set by the Dockerfile). `VITE_*` covers the process-env keys that
      // config reads (VITE_DEV_PORT, VITE_DEV_SERVER_URL, VITE_DEV_HOST) and
      // inlines into the client bundle.
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/scripts/lib/protocol-only-bundle.mjs"
      ],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      // Preserve the caller's OS fixture directory in strict env mode and
      // distinguish cached runs on different filesystems. These are standard
      // OS temp variables, not application configuration.
      "env": ["TMPDIR", "TMP", "TEMP"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.json",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "prisma/schema/**/*.prisma",
        "native/**",
        "vitest.config.*",
        "vite.config.*",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/scripts/test-io-guard.ts",
        "$TURBO_ROOT$/scripts/vitest-test-io-guard-fixture.config.ts",
        "$TURBO_ROOT$/scripts/generate-dokploy-config.ts",
        "$TURBO_ROOT$/scripts/db/**",
        "prisma/migrations/**",
        "prisma/fixtures/**"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "NODE_ENV",
        "PORT",
        "HOST",
        "SERVER_PORT",
        "PORTLESS_*",
        "BETTER_AUTH_*",
        "CORS_ORIGIN",
        "SSO_*",
        "FORCE_SSO",
        "SIGNUP_ENABLED",
        "VAPID_*",
        "TRUST_PROXY_HOPS",
        "OPENROUTER_API_KEY",
        "ANTHROPIC_API_KEY",
        "TRANSLATION_*",
        "RATE_LIMIT_*",
        "SMTP_*",
        "PUBLIC_APP_URL",
        "ADMIN_EMAIL",
        "KB_DATA_ROOT",
        "KB_MASTER_KEY",
        "KB_INSTANCE_ID",
        "VITE_*"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:validate": {
      "inputs": ["prisma/schema/**/*.prisma", "prisma.config.ts"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "ALLOW_NONLOCAL_DB_STUDIO",
        "ASSERT_LOCAL_DB_ESCAPE",
        "EXPECTED_DB",
        "EXPECTED_PORT"
      ]
    },
    "db:seed": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "ALLOW_NONLOCAL_DB_SEED",
        "ASSERT_LOCAL_DB_ESCAPE",
        "EXPECTED_DB",
        "EXPECTED_PORT"
      ]
    }
  }
}
